/* =====================================================
   THEME: RETRO SCIENCE
   – 90s computer / lab control-panel aesthetic
   – Same structure as Vintage Hi-Fi base
   – Cyan, magenta, neon green, deep navy
===================================================== */

@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');

:root {
    /* ===== PRIMARY PALETTE ===== */
    --gold: #00E5FF;
    --gold-light: #66F0FF;
    --gold-dark: #0066FF;
    --champagne: #00E5FF;
    --champagne-light: #E0F2FF;
    --champagne-dark: #7FA8D0;
    --cream: #E0F2FF;
    --cream-bright: #FFFFFF;
    --olive: #4A6A8A;
    --olive-light: #7FA8D0;
    --olive-dark: #4A6A8A;
    --olive-deep: #050914;
    --walnut: #071426;
    --walnut-dark: #050914;
    --walnut-deeper: #02040a;
    --brown: #000000;
    --brown-light: #0a1a30;
    --brown-dark: #000000;

    /* ===== SURFACES ===== */
    --bg-deep: #050914;
    --bg-panel: #071426;
    --bg-elevated: #0a1a30;
    --bg-input: #061020;
    --bg-hover: #0d2242;
    --bg-secondary: #0d2242;

    /* ===== ACCENTS ===== */
    --accent-cyan: #00E5FF;
    --accent-blue: #0066FF;
    --accent-purple: #8A00FF;
    --accent-pink: #FF00A8;
    --accent-magenta: #FF00A8;
    --accent-yellow: #FFD400;
    --accent-green: #39FF14;
    --accent-lime: #39FF14;
    --accent-orange: #FF8A00;
    --accent-red: #FF0055;

    /* ===== GLOWS ===== */
    --glow-cyan: 0 0 8px rgba(0, 229, 255, 0.4), 0 0 16px rgba(0, 229, 255, 0.18);
    --glow-purple: 0 0 8px rgba(138, 0, 255, 0.4), 0 0 16px rgba(138, 0, 255, 0.18);
    --glow-magenta: 0 0 8px rgba(255, 0, 168, 0.4), 0 0 16px rgba(255, 0, 168, 0.18);
    --glow-yellow: 0 0 8px rgba(255, 212, 0, 0.35), 0 0 16px rgba(255, 212, 0, 0.15);
    --glow-green: 0 0 8px rgba(57, 255, 20, 0.35), 0 0 16px rgba(57, 255, 20, 0.15);
    --glow-amber: 0 0 10px rgba(0, 229, 255, 0.4), 0 0 24px rgba(0, 229, 255, 0.2);

    /* ===== TEXT ===== */
    --text-primary: #E0F2FF;
    --text-secondary: #7FA8D0;
    --text-muted: #4A6A8A;
    --text-lcd: #00E5FF;
    --text-lcd-dim: #7FA8D0;

    /* ===== BORDERS ===== */
    --border-subtle: #0d2242;
    --border-default: #1a3a5c;
    --border-strong: #2a5a8c;
    --border-glow: #00E5FF;
    --border-gold: #00E5FF;
    --border-olive: #1a3a5c;

    /* ===== RADII – square corners ===== */
    --radius-sm: 0px;
    --radius-md: 0px;
    --radius-lg: 2px;
    --radius-xl: 2px;

    --font-main: 'Share Tech Mono', 'Consolas', 'Courier New', monospace;
    --font-mono: 'Share Tech Mono', 'Consolas', 'Courier New', monospace;

    --sidebar-width: 280px;
    --header-height: 70px;

    --chat-texture: none;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; height: 100%; overflow: hidden; }

body {
    font-family: var(--font-main);
    background: var(--bg-deep);
    display: flex;
    justify-content: center;
    align-items: center;
    user-select: none;
    -webkit-user-select: none;
    background-image:
        linear-gradient(rgba(0, 229, 255, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 229, 255, 0.025) 1px, transparent 1px),
        radial-gradient(ellipse at 50% 0%, #0a1a30 0%, #050914 60%, #02040a 100%);
    background-size: 32px 32px, 32px 32px, 100% 100%;
    background-attachment: fixed;
    color: var(--text-primary);
    letter-spacing: 0.02em;
}

#particleCanvas {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    z-index: 0; pointer-events: none; opacity: 0.22;
    filter: saturate(1.4) brightness(0.9);
}

/* ===== OUTER SHELL ===== */
.app-shell {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100vw;
    height: 100vh;
    max-width: 100%;
    max-height: 100%;
    background: var(--bg-panel);
    overflow: hidden;
    border: 2px solid var(--border-default);
    box-shadow:
        0 0 40px rgba(0, 0, 0, 0.8),
        inset 0 0 0 1px rgba(0, 229, 255, 0.08),
        inset 0 0 60px rgba(0, 102, 255, 0.04);
    border-radius: 0;
}

/* ===== SIDEBAR ===== */
.sidebar {
    width: var(--sidebar-width);
    min-width: var(--sidebar-width);
    height: 100%;
    background: linear-gradient(180deg, #071426 0%, #050914 100%);
    border-right: 2px solid var(--border-default);
    box-shadow: 4px 0 20px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    z-index: 10;
    transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
    border-radius: 0;
    overflow: hidden;
    position: relative;
}

.sidebar::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: auto;
    bottom: 0;
    width: 3px;
    height: auto;
    background: linear-gradient(180deg,
        var(--accent-cyan) 0%,
        var(--accent-blue) 33%,
        var(--accent-purple) 66%,
        var(--accent-magenta) 100%);
    box-shadow: 0 0 8px rgba(0, 229, 255, 0.6);
    z-index: 1;
}

.sidebar-user-profile-big {
    padding: 20px 16px 16px;
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid var(--border-default);
    background: linear-gradient(135deg, rgba(0, 102, 255, 0.08) 0%, rgba(7, 20, 38, 0.95) 100%);
    flex-shrink: 0;
    box-shadow: none;
    position: relative;
}

.sidebar-user-profile-big::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-cyan), transparent);
    opacity: 0.6;
    pointer-events: none;
}

.sidebar-user-profile-big .big-avatar {
    width: 72px;
    height: 72px;
    border-radius: 0;
    background: #061020;
    border: 2px solid var(--accent-cyan);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.8rem;
    color: var(--accent-cyan);
    flex-shrink: 0;
    box-shadow:
        0 0 12px rgba(0, 229, 255, 0.5),
        inset 0 0 8px rgba(0, 229, 255, 0.15);
    font-family: var(--font-mono);
    position: relative;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.6);
}

.sidebar-user-profile-big .big-avatar::after {
    content: '';
    position: absolute;
    top: 10%;
    left: 18%;
    width: 35%;
    height: 20%;
    background: rgba(0, 229, 255, 0.18);
    border-radius: 50%;
    pointer-events: none;
}

.sidebar-user-profile-big .big-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.sidebar-user-profile-big .big-info { flex: 1; min-width: 0; }
.sidebar-user-profile-big .big-name {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--accent-cyan);
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.6);
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.sidebar-user-profile-big .big-status {
    font-size: 0.72rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.sidebar-user-profile-big .big-status .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 6px rgba(0, 229, 255, 0.7), 0 0 12px rgba(0, 229, 255, 0.4);
    animation: statusPulse 2s ease-in-out infinite;
}

@keyframes statusPulse {
    0%, 100% { box-shadow: 0 0 6px rgba(0, 229, 255, 0.7), 0 0 12px rgba(0, 229, 255, 0.4); }
    50% { box-shadow: 0 0 10px rgba(0, 229, 255, 0.9), 0 0 20px rgba(0, 229, 255, 0.5); }
}

.big-rank {
    display: inline-block;
    padding: 3px 12px;
    border-radius: 0;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    background: linear-gradient(180deg, var(--accent-blue) 0%, var(--accent-purple) 100%);
    box-shadow: 0 0 10px rgba(0, 229, 255, 0.35);
    margin-top: 4px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    border: 1px solid var(--accent-cyan);
}

.big-rank.hidden { display: none; }

.sidebar-section-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-cyan);
    padding: 14px 18px 8px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-main);
    text-shadow: 0 0 6px rgba(0, 229, 255, 0.4);
    border-bottom: 1px solid var(--border-default);
}

.sidebar-section-label .active-users-count {
    background: rgba(57, 255, 20, 0.1);
    color: var(--accent-green);
    padding: 2px 10px;
    border-radius: 0;
    font-size: 0.7rem;
    font-weight: 700;
    border: 1px solid var(--accent-green);
    box-shadow: none;
    text-shadow: 0 0 6px rgba(57, 255, 20, 0.6);
    font-family: var(--font-mono);
}

.sidebar-users {
    flex: 1;
    overflow-y: auto;
    padding: 0 12px 12px;
    background: transparent;
}

.sidebar-users::-webkit-scrollbar { width: 6px; }
.sidebar-users::-webkit-scrollbar-track { background: #050914; border-radius: 0; }
.sidebar-users::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 0;
    border: 1px solid var(--border-default);
}

.sidebar-user-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 0;
    cursor: pointer;
    transition: all 0.15s;
    margin-bottom: 4px;
    position: relative;
    border: 1px solid var(--border-subtle);
    border-left: 2px solid transparent;
    background: rgba(10, 26, 48, 0.5);
    box-shadow: none;
    font-family: var(--font-mono);
}

.sidebar-user-item:hover {
    background: rgba(13, 34, 66, 0.8);
    border-color: var(--border-default);
    border-left-color: var(--accent-cyan);
    box-shadow: 0 0 12px rgba(0, 229, 255, 0.15);
}

.sidebar-user-item.private-partner {
    border-color: var(--border-default);
    background: rgba(138, 0, 255, 0.08);
    box-shadow: 0 0 12px rgba(138, 0, 255, 0.2);
}

.sidebar-user-item .user-avatar {
    width: 38px;
    height: 38px;
    border-radius: 0;
    background: #061020;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--accent-cyan);
    flex-shrink: 0;
    border: 1px solid var(--border-default);
    position: relative;
    overflow: hidden;
    box-shadow: none;
}

.sidebar-user-item .user-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
}

.online-indicator {
    position: absolute;
    bottom: 0px;
    right: 0px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-green);
    border: 2px solid #061020;
    box-shadow:
        0 0 4px rgba(0, 0, 0, 0.5),
        0 0 8px rgba(57, 255, 20, 0.6);
}

.sidebar-user-item .user-info { flex: 1; min-width: 0; }
.sidebar-user-item .user-name {
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
}
.sidebar-user-item .user-status-text {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.sidebar-user-item .private-btn {
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid var(--accent-cyan);
    color: var(--accent-cyan);
    padding: 4px 10px;
    border-radius: 0;
    font-size: 0.65rem;
    cursor: pointer;
    font-weight: 700;
    white-space: nowrap;
    transition: all 0.2s;
    flex-shrink: 0;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-shadow: 0 0 4px rgba(0, 229, 255, 0.4);
    box-shadow: none;
}
.private-btn:hover {
    background: rgba(0, 229, 255, 0.2);
    border-color: var(--accent-cyan);
    box-shadow: 0 0 10px rgba(0, 229, 255, 0.4);
}
.private-btn.accepted {
    background: rgba(57, 255, 20, 0.1);
    color: var(--accent-green);
    border-color: var(--accent-green);
    box-shadow: none;
}
.private-btn.pending {
    background: rgba(255, 212, 0, 0.1);
    color: var(--accent-yellow);
    border-color: var(--accent-yellow);
    animation: pulsePending 1.5s ease-in-out infinite;
}

@keyframes pulsePending {
    0%,100% { box-shadow: 0 0 4px rgba(255, 212, 0, 0.3); }
    50% { box-shadow: 0 0 12px rgba(255, 212, 0, 0.6); }
}

.sidebar-user-item.you-tag .user-name::after {
    content: ' (you)';
    color: var(--accent-cyan);
    font-weight: 700;
    font-size: 0.7rem;
}
.no-users-sidebar {
    text-align: center;
    color: var(--text-muted);
    font-style: normal;
    font-size: 0.75rem;
    padding: 20px 10px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.sidebar-footer {
    padding: 14px 16px;
    border-top: 1px solid var(--border-default);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.7rem;
    color: var(--text-secondary);
    background: rgba(0, 0, 0, 0.4);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    box-shadow: none;
}
.sidebar-footer .status-dot-sm {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    flex-shrink: 0;
    box-shadow: 0 0 6px rgba(0, 229, 255, 0.6);
}

.sidebar-toggle {
    display: none;
    position: static;
    width: 36px;
    height: 36px;
    border-radius: 0;
    background: #061020;
    border: 1px solid var(--border-default);
    color: var(--accent-cyan);
    cursor: pointer;
    font-size: 1.2rem;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
    box-shadow: none;
}
.sidebar-toggle:hover {
    background: rgba(0, 229, 255, 0.12);
    border-color: var(--accent-cyan);
    box-shadow: 0 0 10px rgba(0, 229, 255, 0.35);
}

/* ===== CHAT PANEL ===== */
.chat-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-panel);
    position: relative;
    border-radius: 0;
    overflow: hidden;
    box-shadow:
        inset 0 0 20px rgba(0, 0, 0, 0.7),
        inset 0 0 50px rgba(0, 0, 0, 0.4);
}

.chat-panel::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
        0deg,
        transparent 0px,
        transparent 2px,
        rgba(0, 229, 255, 0.03) 2px,
        rgba(0, 229, 255, 0.03) 3px
    );
    pointer-events: none;
    z-index: 0;
    opacity: 0.4;
}

.chat-header-bar {
    height: var(--header-height);
    min-height: var(--header-height);
    padding: 0 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    border-bottom: 2px solid var(--border-default);
    background: linear-gradient(180deg, #0a1a30 0%, #071426 100%);
    flex-shrink: 0;
    position: relative;
    overflow: visible;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
}

.chat-header-bar::after {
    content: '';
    position: absolute;
    top: auto;
    bottom: -2px;
    left: 0;
    right: 0;
    width: auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-cyan), transparent);
    opacity: 0.5;
    animation: chromeShimmer 7s ease-in-out infinite;
    pointer-events: none;
}

@keyframes chromeShimmer {
    0%,100% { opacity: 0.2; }
    50% { opacity: 0.7; }
}

.header-logo {
    height: 60px;
    width: auto;
    object-fit: contain;
    display: block;
    max-width: none;
    filter: drop-shadow(0 0 8px rgba(0, 229, 255, 0.6));
}
.header-logo-mobile { display: none; }

.header-center { flex: 1; display: flex; justify-content: center; align-items: center; z-index: 3; }
.header-right { display: flex; align-items: center; gap: 8px; z-index: 3; flex-wrap: wrap; }

.badge-pill {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 14px;
    border-radius: 0;
    font-size: 0.68rem;
    font-weight: 600;
    border: 1px solid var(--border-default);
    background: #061020;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: all 0.25s;
    cursor: default;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    box-shadow: inset 0 1px 0 rgba(0, 229, 255, 0.06);
}
.badge-pill.connected-pill {
    border-color: var(--accent-green);
    color: var(--accent-green);
    background: #061020;
    box-shadow: 0 0 10px rgba(57, 255, 20, 0.25);
}
.badge-pill.disconnected-pill {
    border-color: var(--accent-red);
    color: var(--accent-red);
    background: #061020;
    animation: flashAlert 0.7s ease-in-out 3;
}

@keyframes flashAlert {
    0%,100% { box-shadow: 0 0 6px rgba(255, 0, 85, 0.5); }
    50% { box-shadow: 0 0 14px rgba(255, 0, 85, 0.8); }
}

.online-count-badge {
    background: rgba(255, 212, 0, 0.06);
    border: 1px solid var(--accent-yellow);
    color: var(--accent-yellow);
    padding: 5px 12px;
    border-radius: 0;
    font-size: 0.68rem;
    display: flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
    font-weight: 700;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    box-shadow: none;
}
.online-count-badge .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-yellow);
    box-shadow: 0 0 4px var(--accent-yellow);
}

.btn-icon {
    width: 34px;
    height: 34px;
    border-radius: 0;
    background: linear-gradient(180deg, #0d2242 0%, #061020 100%);
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(0, 229, 255, 0.06);
}
.btn-icon img { width: 18px; height: 18px; object-fit: contain; }
.btn-icon:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    background: linear-gradient(180deg, #0d2248 0%, #0a1830 100%);
    box-shadow: 0 0 10px rgba(0, 229, 255, 0.35);
}
.btn-icon.spinning .spin-icon { animation: spin 0.8s linear infinite; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

/* ===== CHAT TABS ===== */
.chat-tabs {
    display: flex;
    border-bottom: 1px solid var(--border-default);
    background: #050914;
    flex-shrink: 0;
    z-index: 2;
    position: relative;
}
.chat-tab {
    flex: 1;
    padding: 10px 12px;
    text-align: center;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
    transition: all 0.25s;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: var(--font-mono);
    background: none;
    box-shadow: none;
}
.chat-tab.active {
    color: var(--accent-cyan);
    border-bottom-color: var(--accent-cyan);
    background: rgba(0, 229, 255, 0.06);
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.7);
    box-shadow: none;
}
.chat-tab:hover {
    color: var(--text-primary);
    background: rgba(0, 229, 255, 0.03);
}

/* ===== MESSAGES ===== */
.messages-container {
    flex: 1;
    overflow-y: auto;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-behavior: smooth;
    background: var(--bg-panel);
    background-image: var(--chat-texture),
        repeating-linear-gradient(0deg, transparent 0px, transparent 2px, rgba(0, 229, 255, 0.03) 2px, rgba(0, 229, 255, 0.03) 3px),
        radial-gradient(circle at 30% 20%, rgba(0, 229, 255, 0.05) 0%, transparent 60%);
    background-blend-mode: normal, normal, normal;
    font-family: var(--font-mono);
    position: relative;
    z-index: 1;
    color: var(--text-primary);
}
.messages-container::-webkit-scrollbar { width: 6px; }
.messages-container::-webkit-scrollbar-track { background: #050914; border-radius: 0; }
.messages-container::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 0;
    border: 1px solid var(--border-default);
}

.empty-chat-hint {
    text-align: center;
    color: var(--text-muted);
    margin: auto;
    font-style: normal;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    animation: fadeInSlow 1s ease-out;
    padding: 40px;
    text-shadow: none;
    font-family: var(--font-mono);
    position: relative;
    z-index: 1;
    text-transform: uppercase;
}

@keyframes fadeInSlow {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
}

.msg-wrapper {
    display: flex;
    flex-direction: column;
    max-width: 82%;
    animation: msgSlideIn 0.35s ease-out;
    position: relative;
    z-index: 1;
}
.msg-wrapper.own {
    align-self: flex-end;
    animation: msgSlideInRight 0.35s ease-out;
}

@keyframes msgSlideIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
}
@keyframes msgSlideInRight {
    from { opacity: 0; transform: translateX(25px); }
    to { opacity: 1; transform: translateX(0); }
}

.msg-bubble {
    padding: 10px 14px;
    border-radius: 0;
    background: linear-gradient(180deg, rgba(10, 26, 48, 0.9) 0%, rgba(6, 16, 32, 0.95) 100%);
    border: 1px solid var(--border-default);
    border-left: 3px solid var(--accent-cyan);
    position: relative;
    word-break: break-word;
    box-shadow:
        inset 0 1px 0 rgba(0, 229, 255, 0.08),
        0 2px 8px rgba(0, 0, 0, 0.5);
    font-family: var(--font-mono);
    transition: box-shadow 0.3s;
}
.msg-wrapper.own .msg-bubble {
    background: linear-gradient(180deg, rgba(30, 8, 50, 0.9) 0%, rgba(15, 4, 28, 0.95) 100%);
    border-color: var(--border-default);
    border-left: 1px solid var(--border-default);
    border-right: 3px solid var(--accent-magenta);
    box-shadow:
        inset 0 -1px 0 rgba(255, 0, 168, 0.08),
        0 2px 8px rgba(0, 0, 0, 0.5);
}
.msg-bubble:hover {
    box-shadow:
        inset 0 1px 0 rgba(0, 229, 255, 0.15),
        0 2px 12px rgba(0, 0, 0, 0.6),
        0 0 12px rgba(0, 229, 255, 0.25);
}

.msg-avatar {
    width: 28px;
    height: 28px;
    border-radius: 0;
    flex-shrink: 0;
    background: #061020;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-cyan);
    border: 1px solid var(--accent-cyan);
    overflow: hidden;
    box-shadow: 0 0 6px rgba(0, 229, 255, 0.3);
}
.msg-avatar img { width: 100%; height: 100%; object-fit: cover; }
.msg-wrapper.own .msg-avatar {
    border-color: var(--accent-magenta);
    box-shadow: 0 0 6px rgba(255, 0, 168, 0.3);
}

.msg-username {
    font-weight: 700;
    font-size: 0.72rem;
    color: var(--accent-cyan);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px dashed rgba(0, 229, 255, 0.2);
    padding-bottom: 4px;
}
.msg-wrapper.own .msg-username {
    color: var(--accent-magenta);
    border-bottom-color: rgba(255, 0, 168, 0.25);
}
.msg-time {
    font-size: 0.65rem;
    color: var(--text-muted);
    margin-left: auto;
    font-weight: 400;
    font-family: var(--font-mono);
}
.msg-text {
    font-size: 0.92rem;
    color: var(--text-primary);
    line-height: 1.5;
    font-family: var(--font-mono);
}
.msg-text.deleted { color: var(--text-muted); font-style: normal; text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.1em; }
.msg-text a { color: var(--accent-cyan) !important; text-decoration: underline; }
.msg-edited {
    font-size: 0.62rem;
    color: var(--accent-yellow);
    margin-left: 4px;
    font-style: italic;
    text-transform: uppercase;
}
.msg-image-wrap {
    margin-top: 8px;
    border-radius: 0;
    overflow: hidden;
    cursor: pointer;
    max-width: 300px;
    border: 1px solid var(--border-default);
    transition: all 0.3s;
    box-shadow: 0 0 8px rgba(0, 229, 255, 0.2);
}
.msg-image-wrap:hover {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 14px rgba(0, 229, 255, 0.4);
}
.msg-image-wrap img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 350px;
    object-fit: cover;
}

/* ===== REPLY BLOCK ===== */
.reply-ref-block {
    background: rgba(0, 229, 255, 0.05);
    border-left: 4px solid var(--accent-cyan);
    padding: 6px 10px;
    border-radius: 0;
    margin-bottom: 6px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    transition: background 0.25s;
    font-family: var(--font-mono);
}
.reply-ref-block:hover {
    background: rgba(0, 229, 255, 0.12);
}
.reply-image-thumb {
    width: 56px;
    height: 56px;
    border-radius: 0;
    object-fit: cover;
    border: 1px solid var(--accent-cyan);
    flex-shrink: 0;
}
.reply-ref-block .r-user {
    font-weight: 600;
    color: var(--accent-cyan);
    font-size: 0.65rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
}
.reply-ref-block .r-text {
    opacity: 0.9;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 220px;
    font-size: 0.72rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
}

.reactions-bar { display: flex; gap: 4px; margin-top: 6px; flex-wrap: wrap; }
.reaction-btn {
    background: rgba(0, 229, 255, 0.05);
    border: 1px solid var(--border-default);
    border-radius: 0;
    padding: 2px 8px;
    font-size: 0.65rem;
    cursor: pointer;
    transition: all 0.25s;
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
}
.reaction-btn.active {
    background: rgba(0, 229, 255, 0.15);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    box-shadow: 0 0 8px rgba(0, 229, 255, 0.35);
}
.reaction-btn:hover {
    background: rgba(0, 229, 255, 0.12);
    border-color: var(--accent-cyan);
    color: var(--text-primary);
}

.msg-actions-container {
    position: absolute;
    top: 4px;
    right: 8px;
    display: flex;
    gap: 3px;
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
}
.msg-bubble:hover .msg-actions-container { opacity: 1; pointer-events: auto; }
.msg-action-btn {
    background: #061020;
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    border-radius: 0;
    padding: 2px 6px;
    font-size: 0.6rem;
    cursor: pointer;
    white-space: nowrap;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.03em;
}
.msg-action-btn:hover {
    background: rgba(0, 229, 255, 0.15);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
}

/* ===== INPUT AREA ===== */
.input-area-bar {
    padding: 8px 12px 10px;
    border-top: 2px solid var(--border-default);
    background: linear-gradient(180deg, #071426 0%, #050914 100%);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    z-index: 2;
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.6);
}

.reply-indicator-bar, .private-indicator-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 0;
    font-size: 0.7rem;
    animation: slideDown 0.25s ease-out;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
}
.reply-indicator-bar {
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid var(--accent-cyan);
    color: var(--accent-cyan);
}
.private-indicator-bar {
    background: rgba(255, 212, 0, 0.08);
    border: 1px solid var(--accent-yellow);
    color: var(--accent-yellow);
}
.reply-preview-thumb {
    width: 30px;
    height: 30px;
    object-fit: cover;
    border-radius: 0;
    border: 1px solid var(--accent-cyan);
    flex-shrink: 0;
}

@keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}

.cancel-btn {
    background: none;
    border: none;
    color: var(--accent-red);
    cursor: pointer;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 2px 6px;
    border-radius: 0;
    transition: all 0.2s;
    flex-shrink: 0;
    font-family: var(--font-mono);
}
.cancel-btn:hover {
    background: rgba(255, 0, 85, 0.2);
}

.input-row-wrap { display: flex; gap: 6px; align-items: center; }

#messageInput {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid var(--border-default);
    border-radius: 0;
    font-size: 0.85rem;
    background: #061020;
    color: var(--text-primary);
    outline: none;
    font-family: var(--font-mono);
    transition: border-color 0.25s, box-shadow 0.25s;
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.6);
    min-width: 0;
}
#messageInput:focus {
    border-color: var(--accent-cyan);
    box-shadow:
        inset 0 2px 8px rgba(0, 0, 0, 0.6),
        0 0 12px rgba(0, 229, 255, 0.4);
}
#messageInput::placeholder {
    color: var(--text-muted);
    text-transform: uppercase;
    font-size: 0.8rem;
}

.btn-upload-img {
    width: 42px;
    height: 42px;
    border-radius: 0;
    background: #061020;
    border: 1px solid var(--border-default);
    color: var(--accent-cyan);
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.25s;
    flex-shrink: 0;
    position: relative;
    box-shadow: none;
}
.btn-upload-img:hover {
    background: rgba(0, 229, 255, 0.12);
    border-color: var(--accent-cyan);
    box-shadow: 0 0 10px rgba(0, 229, 255, 0.35);
}
.btn-upload-img.uploading {
    animation: spin 0.8s linear infinite;
    border-color: var(--accent-cyan);
}
.btn-upload-img.has-image {
    background: rgba(0, 229, 255, 0.2);
    border-color: var(--accent-cyan);
    color: #fff;
}

button.send-btn-main {
    background: linear-gradient(180deg, var(--accent-green) 0%, #1FA010 100%);
    color: #000;
    border: 1px solid var(--accent-green);
    padding: 10px 22px;
    border-radius: 0;
    font-weight: 800;
    cursor: pointer;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: all 0.25s;
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        0 0 12px rgba(57, 255, 20, 0.35);
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    font-family: var(--font-mono);
}
button.send-btn-main:hover {
    background: linear-gradient(180deg, var(--accent-green) 0%, #2BB020 100%);
    border-color: var(--accent-green);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.4),
        0 0 20px rgba(57, 255, 20, 0.6);
    color: #000;
}
button.send-btn-main:active { transform: scale(0.97); }
button.send-btn-main:disabled {
    background: #0a1a30;
    border-color: var(--border-subtle);
    color: var(--text-muted);
    box-shadow: none;
    cursor: not-allowed;
}

/* ===== IMAGE PREVIEW ===== */
.image-preview-row {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(0, 229, 255, 0.06);
    border: 1px solid var(--accent-cyan);
    border-radius: 0;
    padding: 8px 12px;
}
.image-preview-thumb {
    width: 44px;
    height: 44px;
    object-fit: cover;
    border-radius: 0;
    border: 1px solid var(--accent-cyan);
}
.image-preview-name {
    flex: 1;
    font-size: 0.72rem;
    color: var(--accent-cyan);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
}
.image-preview-remove {
    background: none;
    border: none;
    color: var(--accent-red);
    cursor: pointer;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 2px 6px;
    border-radius: 0;
    transition: all 0.2s;
}
.image-preview-remove:hover {
    background: rgba(255, 0, 85, 0.2);
}

/* ===== OVERLAYS ===== */
.request-overlay, .overlay-full {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(3, 6, 14, 0.92);
    z-index: 400;
    display: flex;
    justify-content: center;
    align-items: center;
    backdrop-filter: blur(8px) saturate(1.2);
    border: none;
    border-radius: 0;
}
.request-card, .overlay-card {
    background: linear-gradient(180deg, #0a1a30 0%, #061020 100%);
    padding: 30px 26px;
    border-radius: 0;
    width: 90%;
    max-width: 360px;
    text-align: center;
    border: 1px solid var(--border-default);
    box-shadow:
        0 0 0 1px rgba(0, 229, 255, 0.15),
        0 20px 60px rgba(0, 0, 0, 0.8);
    animation: modalPop 0.4s ease-out;
    font-family: var(--font-mono);
    position: relative;
    overflow: hidden;
}

.request-card::before, .overlay-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg,
        transparent 0%,
        var(--accent-cyan) 25%,
        var(--accent-blue) 50%,
        var(--accent-cyan) 75%,
        transparent 100%);
}

@keyframes modalPop {
    from { opacity: 0; transform: scale(0.8) translateY(25px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
}

.request-avatar {
    width: 100px;
    height: 100px;
    border-radius: 0;
    margin: 0 auto 16px;
    background: #061020;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--accent-cyan);
    box-shadow:
        0 0 12px rgba(0, 229, 255, 0.4),
        inset 0 0 8px rgba(0, 229, 255, 0.15);
}
.request-avatar img { width: 100%; height: 100%; object-fit: cover; }
.request-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent-cyan);
    margin-bottom: 20px;
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-shadow: 0 0 8px rgba(0, 229, 255, 0.6);
}
.request-buttons { display: flex; gap: 12px; justify-content: center; }
.request-buttons button {
    padding: 10px 22px;
    border-radius: 0;
    font-weight: 800;
    cursor: pointer;
    font-size: 0.9rem;
    border: 1px solid var(--border-default);
    transition: all 0.25s;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}
.btn-accept {
    background: linear-gradient(180deg, var(--accent-green) 0%, #1FA010 100%);
    color: #000;
    border-color: var(--accent-green);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        0 0 10px rgba(57, 255, 20, 0.35);
}
.btn-accept:hover {
    background: linear-gradient(180deg, var(--accent-green) 0%, #2BB020 100%);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.4),
        0 0 18px rgba(57, 255, 20, 0.6);
}
.btn-decline {
    background: #061020;
    color: var(--accent-red);
    border-color: var(--accent-red);
}
.btn-decline:hover {
    background: rgba(255, 0, 85, 0.15);
    color: #fff;
    border-color: var(--accent-red);
}

.overlay-full { z-index: 300; }
.overlay-card { max-width: 400px; text-align: left; }
.overlay-card h3 {
    margin-bottom: 18px;
    color: var(--accent-cyan);
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    font-family: var(--font-mono);
    text-transform: uppercase;
    text-align: center;
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.6);
    font-weight: 700;
}
.overlay-card input[type="text"],
.overlay-card input[type="number"],
.overlay-card select,
.overlay-card textarea {
    width: 100%;
    padding: 14px;
    border: 1px solid var(--border-default);
    border-radius: 0;
    font-size: 1rem;
    margin-bottom: 12px;
    background: #061020;
    color: var(--text-primary);
    outline: none;
    font-family: var(--font-mono);
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.6);
    transition: border-color 0.25s, box-shadow 0.25s;
}
.overlay-card input:focus,
.overlay-card select:focus,
.overlay-card textarea:focus {
    border-color: var(--accent-cyan);
    box-shadow:
        inset 0 2px 8px rgba(0, 0, 0, 0.6),
        0 0 12px rgba(0, 229, 255, 0.4);
}
.profile-pic-upload {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin: 12px 0;
}
.profile-pic-preview {
    width: 80px;
    height: 80px;
    border-radius: 0;
    background: #061020;
    border: 2px solid var(--accent-cyan);
    cursor: pointer;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all 0.3s;
    box-shadow: inset 0 0 10px rgba(0, 229, 255, 0.1);
}
.profile-pic-preview img { width: 100%; height: 100%; object-fit: cover; }
.profile-pic-preview:hover {
    border-color: var(--accent-cyan);
    box-shadow:
        inset 0 0 10px rgba(0, 229, 255, 0.15),
        0 0 20px rgba(0, 229, 255, 0.6);
}
.overlay-card button {
    background: linear-gradient(180deg, var(--accent-cyan) 0%, #00A0B8 100%);
    color: #000;
    border: 1px solid var(--accent-cyan);
    padding: 12px 0;
    width: 100%;
    border-radius: 0;
    font-weight: 800;
    cursor: pointer;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
    transition: all 0.25s;
    text-transform: uppercase;
    margin-top: 8px;
    font-family: var(--font-mono);
}
.overlay-card button:hover {
    background: linear-gradient(180deg, #4DEEFF 0%, #00B0C8 100%);
    border-color: var(--accent-cyan);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.4),
        0 0 20px rgba(0, 229, 255, 0.6);
    color: #000;
}
.hidden { display: none !important; }

/* ===== LIGHTBOX ===== */
.lightbox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(3, 6, 14, 0.95);
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
}
.lightbox-overlay img {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 0;
    border: 1px solid var(--accent-cyan);
    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.9),
        0 0 40px rgba(0, 229, 255, 0.3);
    object-fit: contain;
}

/* ===== TOKEN TRACKER ===== */
.token-tracker {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 0;
    background: #061020;
    border: 1px solid var(--border-default);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--text-primary);
    box-shadow: inset 0 1px 0 rgba(0, 229, 255, 0.06);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}
.token-logo {
    width: 20px;
    height: 20px;
    border-radius: 0;
    object-fit: cover;
    border: 1px solid var(--accent-cyan);
    flex-shrink: 0;
}
.token-name { font-weight: 700; color: var(--accent-cyan); white-space: nowrap; text-shadow: 0 0 6px rgba(0, 229, 255, 0.5); }
.token-price { color: var(--text-primary); }
.token-change.positive { color: var(--accent-green); text-shadow: 0 0 6px rgba(57, 255, 20, 0.5); }
.token-change.negative { color: var(--accent-red); text-shadow: 0 0 6px rgba(255, 0, 85, 0.5); }
.token-tracker.mobile-only { display: none; }

/* ===== MOD SETTINGS ===== */
#modSettingsBtn.hidden { display: none; }
#modSettingsOverlay .overlay-card { text-align: left; }
#modSettingsOverlay label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
    color: var(--accent-cyan);
    font-weight: 600;
    letter-spacing: 0.1em;
    font-family: var(--font-mono);
    text-transform: uppercase;
}
#modSettingsOverlay input[type="number"],
#modSettingsOverlay select,
#modSettingsOverlay textarea {
    background: #061020;
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    font-family: var(--font-mono);
    border-radius: 0;
    width: 100%;
    padding: 10px 14px;
    font-size: 0.9rem;
    outline: none;
    transition: all 0.25s;
    margin-bottom: 1rem;
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.6);
}
#modSettingsOverlay input:focus,
#modSettingsOverlay select:focus,
#modSettingsOverlay textarea:focus {
    border-color: var(--accent-cyan);
    box-shadow:
        inset 0 2px 8px rgba(0, 0, 0, 0.6),
        0 0 12px rgba(0, 229, 255, 0.4);
}
#modSaveSettingsBtn, #modCloseSettingsBtn {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border-default);
    border-radius: 0;
    cursor: pointer;
    font-weight: 800;
    transition: all 0.25s;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
}
#modSaveSettingsBtn {
    background: linear-gradient(180deg, var(--accent-green) 0%, #1FA010 100%);
    color: #000;
    border-color: var(--accent-green);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        0 0 10px rgba(57, 255, 20, 0.35);
}
#modSaveSettingsBtn:hover {
    background: linear-gradient(180deg, var(--accent-green) 0%, #2BB020 100%);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.4),
        0 0 18px rgba(57, 255, 20, 0.6);
}
#modCloseSettingsBtn {
    background: #061020;
    color: var(--text-secondary);
}
#modCloseSettingsBtn:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--accent-cyan);
    box-shadow: 0 0 10px rgba(0, 229, 255, 0.35);
}

/* ===== MOD MESSAGE BOX ===== */
.mod-message-box {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    background: rgba(255, 0, 85, 0.06);
    border: 1px solid rgba(255, 0, 85, 0.4);
    border-left: 3px solid var(--accent-red);
    border-radius: 0;
    color: #FFD0D8;
    font-size: 0.85rem;
    flex-shrink: 0;
    z-index: 5;
    font-family: var(--font-mono);
}
.mod-badge {
    background: var(--accent-red);
    border: none;
    color: #000;
    padding: 3px 10px;
    border-radius: 0;
    font-weight: 800;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    flex-shrink: 0;
    box-shadow: 0 0 8px rgba(255, 0, 85, 0.6);
}
.mod-message-text {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #FFD0D8;
    font-family: var(--font-mono);
}

/* ===== COOLDOWN ===== */
.cooldown-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    background: rgba(255, 212, 0, 0.08);
    border: 1px solid var(--accent-yellow);
    border-radius: 0;
    color: var(--accent-yellow);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
}
.cooldown-indicator.hidden { display: none; }

/* ===== SCROLL TO BOTTOM ===== */
.scroll-bottom-btn {
    position: absolute;
    bottom: 88px;
    right: 22px;
    width: 46px;
    height: 46px;
    border-radius: 0;
    background: #061020;
    border: 1px solid var(--accent-cyan);
    color: var(--accent-cyan);
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    box-shadow:
        0 0 10px rgba(0, 0, 0, 0.5),
        0 0 16px rgba(0, 229, 255, 0.3);
    z-index: 15;
    font-size: 1.4rem;
    transition: all 0.25s;
}
.scroll-bottom-btn.visible { display: flex; }
.scroll-bottom-btn:hover {
    background: rgba(0, 229, 255, 0.15);
    color: #fff;
    box-shadow:
        0 0 14px rgba(0, 0, 0, 0.5),
        0 0 24px rgba(0, 229, 255, 0.55);
    transform: translateY(-2px);
}

/* ===== TYPING INDICATOR ===== */
.typing-indicator {
    font-size: 0.72rem;
    color: var(--accent-cyan);
    padding: 6px 16px;
    font-style: normal;
    min-height: 30px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    flex-shrink: 0;
    background: rgba(0, 229, 255, 0.03);
    border-bottom: 1px solid var(--border-default);
    font-family: var(--font-mono);
    z-index: 2;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}
.typing-dots { display: inline-flex; align-items: center; }
.typing-dots span {
    width: 8px;
    height: 8px;
    background: var(--accent-cyan);
    border-radius: 50%;
    margin: 0 2px;
    animation: typingDot 1.2s infinite ease-in-out;
    box-shadow: 0 0 6px var(--accent-cyan);
}
.typing-dots span:nth-child(2) { animation-delay: 0.2s; }
.typing-dots span:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingDot {
    0%,60%,100% { opacity: 0.3; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-4px); }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        height: 100%;
        z-index: 25;
        transform: translateX(-100%);
    }
    .sidebar.open {
        transform: translateX(0);
        box-shadow: 4px 0 20px rgba(0, 0, 0, 0.7);
    }
    .sidebar-toggle { display: flex; width: 44px; height: 44px; font-size: 1.4rem; }
    .chat-panel { width: 100%; }
    .msg-wrapper { max-width: 92%; }
    .msg-image-wrap { max-width: 220px; }
    #messageInput { font-size: 0.8rem; padding: 10px 12px; }
    button.send-btn-main { padding: 8px 16px; font-size: 0.7rem; }
    .chat-header-bar { padding: 0 10px; justify-content: center; position: relative; }
    .badge-pill { font-size: 0.68rem; padding: 5px 10px; }
    .online-count-badge { font-size: 0.68rem; padding: 4px 10px; }
    .conn-text-full { display: none; }
    .typing-indicator { font-size: 0.72rem; }
    .sidebar-user-profile-big .big-avatar { width: 56px; height: 56px; font-size: 1.4rem; }
    .sidebar-user-profile-big .big-name { font-size: 1rem; }
    .header-left .header-logo { display: none; }
    .header-logo-mobile {
        display: block;
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        height: 50px;
        width: auto;
        max-width: none;
        object-fit: contain;
        z-index: 1;
        filter: drop-shadow(0 0 8px rgba(0, 229, 255, 0.6));
    }
    .header-left, .header-right { position: absolute; left: 10px; z-index: 2; }
    .header-right { left: auto; right: 10px; }
    .header-right .badge-pill,
    .header-right .online-count-badge,
    .header-right .wallet-address,
    .header-right #refreshBtn { display: none !important; }
    .mobile-edit-btn { display: flex; }
    .header-center { display: none; }
    .token-tracker.mobile-only {
        display: flex;
        margin: 12px;
        padding: 6px 10px;
        border-radius: 0;
        background: #061020;
        border: 1px solid var(--border-default);
        font-size: 0.7rem;
        justify-content: center;
        align-items: center;
        gap: 6px;
    }
    .scroll-bottom-btn { bottom: 80px; }
}

.mobile-edit-btn { display: none; }

.user-badge { font-size: 0.75rem; margin-left: 4px; vertical-align: middle; }
.user-badge.small { font-size: 0.65rem; margin-left: 3px; }

.theme-select {
    appearance: none;
    -webkit-appearance: none;
    background: #061020;
    color: var(--text-primary);
    border: 1px solid var(--border-default);
    border-radius: 0;
    padding: 4px 8px;
    cursor: pointer;
    font-size: 0.72rem;
    font-family: var(--font-main);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition: border-color 0.25s, box-shadow 0.25s;
    height: 34px;
    line-height: 1;
}
.theme-select:hover {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 10px rgba(0, 229, 255, 0.35);
}
.theme-select:focus {
    outline: none;
    border-color: var(--accent-cyan);
    box-shadow: 0 0 10px rgba(0, 229, 255, 0.35);
}
